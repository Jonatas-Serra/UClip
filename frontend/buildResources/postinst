#!/bin/bash
# UClip — DEB post-installation
# - Cria wrappers /usr/local/bin/uclip-api e /usr/local/bin/uclip-listener
# - Cria systemd USER services (não system) — rodam na sessão gráfica do usuário
# - Registra atalho Super+V via gsettings (GNOME) ou swaymsg (Sway)

set -e

INSTALL_DIR="/opt/UClip"
VENV_DIR="$INSTALL_DIR/.venv"

# Locate backend (varies depending on packaging).
# Com asar: true + asarUnpack, o backend fica em resources/app.asar.unpacked/app.
BACKEND_DIR=""
for candidate in \
    "$INSTALL_DIR/resources/app.asar.unpacked/app/backend" \
    "$INSTALL_DIR/resources/app/app/backend" \
    "$INSTALL_DIR/app/backend" \
    "$INSTALL_DIR/backend"; do
    if [ -d "$candidate" ]; then
        BACKEND_DIR="$candidate"
        break
    fi
done

# Falha explícita se não achamos o backend: sem isto, dirname "" vira "." e os
# wrappers saem com `cd "."`, quebrando os serviços com ModuleNotFoundError.
if [ -z "$BACKEND_DIR" ]; then
    echo "[UClip] ❌ Erro: diretório backend não encontrado sob $INSTALL_DIR"
    exit 1
fi

echo "[UClip] Diretório de instalação: $INSTALL_DIR"
echo "[UClip] Backend localizado em:   $BACKEND_DIR"

# --- Dependências Python ----------------------------------------------------
if ! command -v python3 &> /dev/null; then
    echo "[UClip] Instalando Python 3..."
    apt-get update || true
    apt-get install -y python3 python3-pip python3-venv xclip wl-clipboard || true
fi

if ! command -v python3 &> /dev/null; then
    echo "[UClip] ❌ Erro: Python 3 não foi instalado"
    exit 1
fi

# venv
if [ ! -d "$VENV_DIR" ]; then
    echo "[UClip] Criando virtualenv Python..."
    python3 -m venv "$VENV_DIR" || { echo "[UClip] ❌ Erro ao criar venv"; exit 1; }
fi

if [ -f "$BACKEND_DIR/requirements.txt" ]; then
    echo "[UClip] Instalando dependências Python..."
    "$VENV_DIR/bin/pip" install --upgrade pip wheel >/dev/null 2>&1 || true
    "$VENV_DIR/bin/pip" install -r "$BACKEND_DIR/requirements.txt" || {
        echo "[UClip] ❌ Erro ao instalar dependências"
        exit 1
    }
fi

# --- Wrappers ---------------------------------------------------------------
mkdir -p /usr/local/bin

# Determina o subdiretório que contém o pacote backend para o cd
BACKEND_PARENT_DIR=$(dirname "$BACKEND_DIR")

cat > /usr/local/bin/uclip-api << SCRIPT
#!/bin/bash
cd "$BACKEND_PARENT_DIR"
source "$VENV_DIR/bin/activate"
exec python3 -m backend.cli.run_api
SCRIPT
chmod +x /usr/local/bin/uclip-api

cat > /usr/local/bin/uclip-listener << SCRIPT
#!/bin/bash
cd "$BACKEND_PARENT_DIR"
source "$VENV_DIR/bin/activate"
exec python3 -m backend.cli.run_listener
SCRIPT
chmod +x /usr/local/bin/uclip-listener

# Symlink do binário Electron para /usr/local/bin/uclip caso ainda não exista
[ -x "$INSTALL_DIR/uclip" ] && ln -sf "$INSTALL_DIR/uclip" /usr/local/bin/uclip || true

# --- Permissões do sandbox do Chromium --------------------------------------
if [ -f "$INSTALL_DIR/chrome-sandbox" ]; then
    chown root:root "$INSTALL_DIR/chrome-sandbox"
    chmod 4755 "$INSTALL_DIR/chrome-sandbox"
fi
if [ -f "$INSTALL_DIR/chrome_crashpad_handler" ]; then
    chown root:root "$INSTALL_DIR/chrome_crashpad_handler"
    chmod 4755 "$INSTALL_DIR/chrome_crashpad_handler"
fi

# --- USER systemd services + GNOME hotkey por usuário -----------------------
configure_user() {
    local username=$1
    local user_home=$2
    local user_id
    user_id=$(id -u "$username" 2>/dev/null) || return 0

    local user_systemd_dir="$user_home/.config/systemd/user"
    mkdir -p "$user_systemd_dir"

    cat > "$user_systemd_dir/uclip-backend.service" << UNIT
[Unit]
Description=UClip Backend API
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/uclip-api
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
UNIT

    cat > "$user_systemd_dir/uclip-listener.service" << UNIT
[Unit]
Description=UClip Clipboard Listener
After=graphical-session.target uclip-backend.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/uclip-listener
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
UNIT

    chown -R "$username:$username" "$user_home/.config/systemd"

    # Daemon-reload e enable+start como o usuário
    local user_env="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$user_id/bus XDG_RUNTIME_DIR=/run/user/$user_id"
    sudo -u "$username" env $user_env systemctl --user daemon-reload 2>/dev/null || true
    sudo -u "$username" env $user_env systemctl --user enable uclip-backend.service uclip-listener.service 2>/dev/null || true
    # Tenta startar (só funciona se há sessão ativa; senão, sobe no próximo login)
    sudo -u "$username" env $user_env systemctl --user start uclip-backend.service uclip-listener.service 2>/dev/null || true

    # Atalho Super+V via gsettings (GNOME). Idempotente.
    sudo -u "$username" env $user_env bash << 'GSETTINGS'
if ! command -v gsettings >/dev/null 2>&1; then
    exit 0
fi

SCHEMA="org.gnome.settings-daemon.plugins.media-keys"
PATH_BASE="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings"
NEW_PATH="$PATH_BASE/uclip/"
SCHEMA_CB="$SCHEMA.custom-keybinding:$NEW_PATH"

CURRENT=$(gsettings get "$SCHEMA" custom-keybindings 2>/dev/null || echo "@as []")

# Adiciona o path do UClip à lista, se ainda não estiver lá
if ! echo "$CURRENT" | grep -q "uclip"; then
    if [ "$CURRENT" = "@as []" ] || [ "$CURRENT" = "[]" ]; then
        NEW="['$NEW_PATH']"
    else
        # remove o "]" final e insere a entrada
        NEW="${CURRENT%]}, '$NEW_PATH']"
    fi
    gsettings set "$SCHEMA" custom-keybindings "$NEW" 2>/dev/null || true
fi

gsettings set "$SCHEMA_CB" name 'UClip Toggle' 2>/dev/null || true
gsettings set "$SCHEMA_CB" command '/usr/local/bin/uclip --toggle' 2>/dev/null || true
gsettings set "$SCHEMA_CB" binding '<Super>v' 2>/dev/null || true
GSETTINGS

    echo "[UClip] ✓ Configurado para: $username"
}

echo "[UClip] Configurando user services e atalho para cada usuário..."
for user_home in /home/*/; do
    [ -d "$user_home" ] || continue
    username=$(basename "$user_home")
    # Pula usuários sem login válido
    if ! id "$username" >/dev/null 2>&1; then continue; fi
    configure_user "$username" "$user_home"
done

echo ""
echo "[UClip] ✅ Instalação concluída!"
echo ""
echo "    • Histórico: pressione  Super+V"
echo "    • Tray icon: 📋 na bandeja do sistema"
echo "    • CLI:       uclip [--toggle]"
echo ""
echo "[UClip] Status dos serviços (rode como seu usuário):"
echo "    systemctl --user status uclip-backend.service"
echo "    systemctl --user status uclip-listener.service"
echo ""
